[Unit]
Description=SASP SUD - API et bot Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sasp
WorkingDirectory=/opt/sasp/vps
EnvironmentFile=/etc/sasp/api.env
ExecStartPre=/bin/cp /opt/sasp/worker.js /opt/sasp/vps/worker.js
ExecStart=/usr/bin/node serveur.js
Restart=always
RestartSec=5
# Le service n'ecrit que dans la base et sa copie du worker : le reste
# du disque lui reste en lecture seule.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/sasp /opt/sasp/vps
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sasp-api

[Install]
WantedBy=multi-user.target
