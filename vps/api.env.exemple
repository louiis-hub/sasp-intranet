# A copier dans /etc/sasp/api.env, puis : chmod 600 /etc/sasp/api.env
# Ce fichier porte les memes secrets que Cloudflare. Il ne va JAMAIS
# dans le depot.

# --- secrets, a reprendre depuis Cloudflare > Workers > Variables ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
SUPABASE_SERVICE_KEY=
SUPABASE_NORD_SERVICE_KEY=
NORD_SUPABASE_SERVICE_KEY=
LOG_TOKEN=SASPlogs2026!

# --- les [vars] de wrangler.toml, reprises a l'identique ---
AUTO_ROLE_SYNC=1
POINTEUSE_CHANNEL_ID=1515025043472650281
POINTEUSE_MESSAGE_ID=1542935975431249921
POINTEUSE_CLAIM_CHANNEL_ID=1533451858209931477
PLAINTESASP_CHANNEL_ID=1538289329917534328

# --- propre au VPS ---
PORT=8787
HOTE=127.0.0.1
