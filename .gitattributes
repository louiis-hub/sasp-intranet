# Les gros fichiers du site sont historiquement en CRLF : on n y touche pas,
# git le ferait sur des milliers de lignes pour rien.
* -text

# Ce qui part sur le VPS doit etre en LF. Un script shell ou une unite
# systemd en CRLF donne "bad interpreter: /bin/bash^M" et rien d autre.
vps/* text eol=lf
vps/**/* text eol=lf
web/* text eol=lf
web/**/* text eol=lf
*.md text eol=lf
